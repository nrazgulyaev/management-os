# --- Database (Drizzle / postgres.js) ----------------------------------------
# Pooled connection used by the app at runtime (port 6543, transaction pooler).
# Example: postgres://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.guxyietjobtmcwfbxxkc:33434646NnNn15071992@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?sslmode=require


# Direct connection used for migrations and drizzle-kit (port 5432).
# Example: postgres://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres.guxyietjobtmcwfbxxkc:33434646NnNn15071992@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?sslmode=require

# --- App ---------------------------------------------------------------------
# Optional. When unset, server-rendered admin pages fall back to read-only mock data.
# Set ARCONIQUE_FORCE_MOCK=1 to ignore configured DB and always render mock data
# (useful for marketing demos and storybook-like flows).
ARCONIQUE_FORCE_MOCK=

# Public flag. Set to "1" to surface the demo banner / quick-links on admin pages.
NEXT_PUBLIC_ENABLE_DEMO_MODE=1

# --- Admin bootstrap ---------------------------------------------------------
# Long random string. Required by /setup/admin-bootstrap once a super_admin
# already exists. The first super_admin can be created without it.
# Generate with: openssl rand -hex 32
ADMIN_BOOTSTRAP_SECRET=bbef966fcac0556be7e9a96f0ce2f14be5365e9fe371e5ea610bcab3612afa4b
# ================================
# Application
# ================================
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production
APP_BASE_URL=https://app.arconique.com

# ================================
# Security secrets (PASTE generated values)
# ================================
CRON_SECRET=<paste-generated-cron-secret>
SECURITY_ENCRYPTION_SECRET=<paste-generated-security-secret>
STAY_LINK_KMS_SECRET=<paste-generated-kms-secret>

# ================================
# Dry-run mode (для launch — disable когда ready)
# ================================
NOTIFICATIONS_DRY_RUN=1
AI_DRY_RUN=1

# ================================
# MFA
# ================================
MFA_ISSUER=Arconique
