# Arconique Management OS — environment template
# Copy to .env.local and fill in real values for local development.
# Never commit .env.local. Never put production keys in this file.
# Treat the service-role key like a root password.

# --- Supabase project ---------------------------------------------------------
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side ONLY. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Drizzle / postgres.js) ----------------------------------------
# Pooled connection used by the app at runtime (port 6543, transaction pooler).
# Example: postgres://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Direct connection used for migrations and drizzle-kit (port 5432).
# Example: postgres://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL=


# --- App ---------------------------------------------------------------------
# Optional. When unset, server-rendered admin pages fall back to read-only mock data.
# Set ARCONIQUE_FORCE_MOCK=1 to ignore configured DB and always render mock data
# (useful for marketing demos and storybook-like flows).
ARCONIQUE_FORCE_MOCK=

# Public flag. Set to "1" to surface the demo banner / quick-links on admin pages.
NEXT_PUBLIC_ENABLE_DEMO_MODE=

# --- Admin bootstrap ---------------------------------------------------------
# Long random string. Required by /setup/admin-bootstrap once a super_admin
# already exists. The first super_admin can be created without it.
# Generate with: openssl rand -hex 32
ADMIN_BOOTSTRAP_SECRET=

# --- Background jobs / Vercel Cron -------------------------------------------
# Long random shared secret. Required by /api/cron/* endpoints in production:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://app/api/cron/run-all
# When CRON_SECRET is unset AND the request comes from localhost, the cron
# endpoints accept the call with a warning log so a developer can run
# `curl http://localhost:3000/api/cron/run-all` without setup. Production
# (NODE_ENV=production) always rejects unauthenticated requests.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Public base URL of the deployed app — used by cron docs and any helper
# code that builds absolute URLs. Example: https://management.arconique.com
APP_BASE_URL=
