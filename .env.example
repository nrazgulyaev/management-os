# Arconique Management OS — environment template
# Copy to .env.local and fill in real values for local development.
# Never commit .env.local. Never put production keys in this file.
# Treat the service-role key like a root password.

# --- Subdomain dev model (Sprint 2) ------------------------------------------
# Production splits product surfaces across four subdomains. Locally,
# most browsers resolve `*.localhost` natively — if yours doesn't,
# add the following to /etc/hosts:
#
#   127.0.0.1 management.localhost
#   127.0.0.1 development.localhost
#   127.0.0.1 subscription.localhost
#   127.0.0.1 platform.localhost
#
# Then open:
#   http://management.localhost:3000      → Management OS
#   http://development.localhost:3000     → Development OS
#   http://subscription.localhost:3000    → Public sales (Sprint 3 content)
#   http://platform.localhost:3000        → Platform Admin OS (super_admin)
#
# See docs/DEV-SETUP.md for the full routing table + smoke-test recipes.
# No env vars are required for the subdomain model — middleware reads
# the request host directly.

# --- Supabase project ---------------------------------------------------------
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side ONLY. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Drizzle / postgres.js) ----------------------------------------
# Pooled connection used by the app at runtime (port 6543, transaction pooler).
# Example: postgres://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Direct connection used for migrations and drizzle-kit (port 5432).
# Example: postgres://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL=


# --- App ---------------------------------------------------------------------
# Optional. When unset, server-rendered admin pages fall back to read-only mock data.
# Set ARCONIQUE_FORCE_MOCK=1 to ignore configured DB and always render mock data
# (useful for marketing demos and storybook-like flows).
ARCONIQUE_FORCE_MOCK=

# Public flag. Set to "1" to surface the demo banner / quick-links on admin pages.
NEXT_PUBLIC_ENABLE_DEMO_MODE=

# --- Admin bootstrap ---------------------------------------------------------
# Long random string. Required by /setup/admin-bootstrap once a super_admin
# already exists. The first super_admin can be created without it.
# Generate with: openssl rand -hex 32
ADMIN_BOOTSTRAP_SECRET=

# Comma-separated operator email allowlist for the cross-tenant Platform OS
# (org CRUD, impersonation, subscription-OS, platform agents/flags). The
# super_admin role alone is NOT enough — it is also granted to every tenant
# org admin on signup/provisioning, so the platform helpers additionally
# require the signed-in email to be on this list. FAIL-CLOSED: if unset, no
# live user can reach the Platform OS (demo mode is exempt). Set this to your
# operator address(es) in production.
#   PLATFORM_ADMIN_EMAILS=ops@arconique.com,founder@arconique.com
PLATFORM_ADMIN_EMAILS=

# --- Background jobs / Vercel Cron -------------------------------------------
# Long random shared secret. Required by /api/cron/* endpoints in production:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://app/api/cron/run-all
# When CRON_SECRET is unset AND the request comes from localhost, the cron
# endpoints accept the call with a warning log so a developer can run
# `curl http://localhost:3000/api/cron/run-all` without setup. Production
# (NODE_ENV=production) always rejects unauthenticated requests.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Public base URL of the deployed app — used by cron docs and any helper
# code that builds absolute URLs. Example: https://management.arconique.com
APP_BASE_URL=

# --- Notification providers (v8A) --------------------------------------------
# Default safe behavior: dry-run mode (in_app + log only, no external sends).
# Set NOTIFICATIONS_DRY_RUN=0 + provider env to enable real delivery.
# When env is missing or NOTIFICATIONS_DRY_RUN=1, the worker uses the noop
# provider — queue/inbox state still updates, but nothing leaves the server.
NOTIFICATIONS_DRY_RUN=1

# Resend (email). https://resend.com — only used when both vars are set.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Twilio (SMS / WhatsApp). https://www.twilio.com — only used when account SID
# and auth token are set. From-numbers are required only for the channel
# you actually want to send through.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WHATSAPP=

# --- AI Operations Co-pilot (v8B) --------------------------------------------
# Default safe behavior: AI is OFF unless ANTHROPIC_API_KEY is set AND
# AI_DRY_RUN=0. Otherwise the dashboard renders a deterministic fallback
# summary built from live ops data — no external API call.
AI_DRY_RUN=1

# Anthropic API key. Read-only Operations Co-pilot v0 uses this with a
# strict server-side tool allowlist (no writes, no secrets).
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-3-5-haiku-latest.
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Guest stay security (v9G) -----------------------------------------------
# 32+ random bytes used to derive AES-256-GCM data keys for Wi-Fi password
# encryption (`villa_wifi_credentials.password_ciphertext`).
#
# Production REQUIRED: encryption / decryption refuse to operate when this
# is missing in NODE_ENV=production.
# Development OPTIONAL: code falls back to a deterministic dev-only key
# with a loud `console.warn`. Never ship that fallback to production.
#
# Generate with: openssl rand -hex 48
STAY_LINK_KMS_SECRET=

# ---------------------------------------------------------------------------
# Prompt 111 — Security baseline & operational hardening.
# ---------------------------------------------------------------------------

# Wraps MFA TOTP secrets at rest with AES-256-GCM.
# Production REQUIRED.  Development OPTIONAL — code falls back to a
# deterministic dev-only key with a loud warning.  Never ship the
# fallback to production.  Generate with: openssl rand -hex 48
SECURITY_ENCRYPTION_SECRET=

# otpauth:// issuer label shown in authenticator apps.
MFA_ISSUER=Arconique

# Login throttling.  Enabled by default; set to 0 to disable in dev.
LOGIN_THROTTLE_ENABLED=1
LOGIN_MAX_FAILED_PER_EMAIL=5
LOGIN_MAX_FAILED_PER_IP=20
LOGIN_LOCK_MINUTES=15

# Max concurrent runs of any one cron job.  Always 1 with current locks.
CRON_MAX_CONCURRENT_PER_JOB=1

# Public link to the backup / restore runbook (shown on /dashboard/system/health).
BACKUP_RUNBOOK_URL=

# ---------------------------------------------------------------------------
# Sprint 3b — Stripe billing.
# ---------------------------------------------------------------------------
# Required for /api/billing/checkout, /api/webhooks/billing/stripe, and
# scripts/stripe-provision.ts (the script that creates one Stripe Product
# + monthly + annual Price per row in plan_packaging).
#
# All three keys are server-side. The provisioning script and the
# checkout endpoint refuse to operate without STRIPE_SECRET_KEY +
# STRIPE_PUBLISHABLE_KEY. The webhook handler refuses to operate
# without STRIPE_BILLING_WEBHOOK_SECRET (distinct from the payment-
# intents webhook secret used by direct-bookings).
#
# Strongly recommended: use `sk_test_…` for the FIRST run of
# `npm run stripe:provision:apply`. Inspect the resulting products and
# prices in the Stripe Dashboard (test mode). Promote to `sk_live_…`
# only after the Dashboard view looks right.
#
# When unset, the Stripe-dependent surfaces gracefully degrade:
#   - /api/billing/checkout returns 503 {"reason":"stripe_not_configured"}
#   - /dashboard/billing/upgrade still renders, with "Stripe price not
#     yet provisioned" badges in place of the upgrade button
#   - /api/webhooks/billing/stripe returns 503 {"reason":"...not_configured"}
#
# Stripe Dashboard → Developers → API keys → Reveal test key.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Stripe Dashboard → Developers → Webhooks → Add endpoint →
#   URL: https://<your-host>/api/webhooks/billing/stripe
#   Events: customer.subscription.*, invoice.paid,
#           invoice.payment_failed, invoice.payment_action_required
# Then reveal the Signing secret and paste here.
STRIPE_BILLING_WEBHOOK_SECRET=

# Optional override — defaults to https://api.stripe.com.
# Set to https://api.stripe.com explicitly in test envs if you proxy
# Stripe through a tunnel (e.g. ngrok); otherwise leave blank.
# STRIPE_API_BASE=
