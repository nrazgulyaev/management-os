        "src/lib/development/server/cron/qa-qc-deadline-alert-job.ts",
        "src/lib/development/server/cron/resource-conflict-detector-job.ts",
        "src/lib/development/server/cron/risk-elevation-alert-job.ts",
        "src/lib/development/server/cron/risk-radar-weekly-job.ts",
        "src/lib/development/server/cron/wallet-recompute-job.ts",
        "src/lib/development/server/cron/weekly-construction-plan-job.ts",
        "src/lib/development/server/import-template-actions.ts",
        "src/lib/development/server/inventory/inventory-queries.ts",
        "src/lib/development/server/notifications/notification-actions.ts",
        "src/lib/development/server/notifications/notification-dispatcher.ts",
        "src/lib/development/server/offline-sync/sync-actions.ts",
        "src/lib/development/server/revenue-streams/revenue-stream-queries.ts",
        "src/lib/development/server/schedule/schedule-queries.ts"
      ],
      "rules": {
        "no-restricted-syntax": [
          "warn",
          {
            "selector": "TSAsExpression > TSTypeLiteral > TSPropertySignature[key.name='rows']",
            "message": "postgres-js db.execute() returns an Array, not { rows }. `(x as { rows }).rows` reads undefined -> silent []. Use rowsOf<T>(result) from @/lib/db/client. (SHAPE-BUG-SWEEP-1)"
          }
        ]
      }
    }
  ]
}
