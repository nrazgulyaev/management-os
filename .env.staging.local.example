# .env.staging.local.example — template for STAGING Supabase credentials.
#
# Copy to .env.staging.local and fill with values from your STAGING Supabase
# project (NOT production). `.env.staging.local` is gitignored (.env*.local),
# so real secrets never get committed. This .example file is safe to commit.
#
# Used ONLY by:  npm run db:migrate:staging   and   npm run seed:staging
# Those scripts load ONLY this file — never .env.production.local — so they
# cannot reach prod. NEVER paste production credentials here.

# ── Safety guard (REQUIRED) ──────────────────────────────────────────────
# The staging scripts refuse to run unless this is exactly "staging".
ARCONIQUE_DB_ENV=staging

# ── App runtime connection ───────────────────────────────────────────────
# Supabase TRANSACTION pooler (Supavisor, port 6543). `prepare:false` is
# enforced in code. Supabase dashboard → Connect → "Transaction pooler".
DATABASE_URL=postgresql://postgres.<STAGING_PROJECT_REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:6543/postgres

# ── Migrations connection ────────────────────────────────────────────────
# SESSION pooler (port 5432) or the Direct connection. Used by db:migrate.
# Supabase dashboard → Connect → "Session pooler" (or "Direct connection").
DIRECT_URL=postgresql://postgres.<STAGING_PROJECT_REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:5432/postgres

# ── Supabase auth (public, exposed to browser) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<STAGING_PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<staging anon / publishable key>

# ── Supabase service role (server-only secret) ───────────────────────────
SUPABASE_SERVICE_ROLE_KEY=<staging service_role key>
